{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tta-challenges",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/challenge/*", "/player/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tta-challenges",
      "database_id": "0b5edb96-f1ef-4c28-ab58-80f0952e3323",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Proof links must point to a message in this Discord server.
    "DISCORD_GUILD_ID": "358698681672925195",
    // Optional Cloudflare Turnstile site key; leave empty to disable the captcha.
    "TURNSTILE_SITE_KEY": ""
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   ADMIN_TOKEN       password for the /admin page
  //   TURNSTILE_SECRET  only if TURNSTILE_SITE_KEY is set
}
